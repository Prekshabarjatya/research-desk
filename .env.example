OPENROUTER_API_KEY=your_openrouter_api_key_here
# Check a model and its endpoints with:
#   curl https://openrouter.ai/api/v1/models/nvidia/nemotron-3.5-lightning:free/endpoints
OPENROUTER_MODEL_FAST=nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL_STRONG=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_REASONING=1
OPENROUTER_PROVIDER=nvidia   # only NVIDIA's endpoints, no fallbacks; leave empty to let OpenRouter route

# Optional fallback provider (any OpenAI-compatible endpoint)
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL_FAST=
FALLBACK_MODEL_STRONG=

# Polite-pool contact emails for the free literature APIs
OPENALEX_MAILTO=
CROSSREF_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=            # optional; helps when a shared host IP is rate limited

MAX_REVISIONS=3
MAX_TOKENS_PER_RUN=400000

# --- Service (required by docker-compose) ---
POSTGRES_PASSWORD=change-me
DOMAIN=localhost            # your real domain in production; Caddy fetches the TLS cert for it
API_TOKEN=change-me         # bearer token clients must send; empty locks the API entirely
MAX_ACTIVE_RUNS=20

# --- Hosted deploys ---
RUN_WORKER=0                # 1 = run the worker inside the API process (Render single service)
CORS_ORIGINS=               # your Vercel URL if the UI is hosted there, comma-separated
