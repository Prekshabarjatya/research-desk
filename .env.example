GROQ_API_KEY=your_groq_api_key_here
# Groq's lineup changes; list what your account can use with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_STRONG=openai/gpt-oss-120b

# Optional fallback provider (any OpenAI-compatible endpoint)
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL_FAST=
FALLBACK_MODEL_STRONG=

# Polite-pool contact emails for the free literature APIs
OPENALEX_MAILTO=
CROSSREF_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=            # optional; helps when a shared host IP is rate limited

MAX_REVISIONS=3
MAX_TOKENS_PER_RUN=400000

# --- Service (required by docker-compose) ---
POSTGRES_PASSWORD=change-me
DOMAIN=localhost            # your real domain in production; Caddy fetches the TLS cert for it
API_TOKEN=change-me         # bearer token clients must send; empty locks the API entirely
MAX_ACTIVE_RUNS=20

# --- Hosted deploys ---
RUN_WORKER=0                # 1 = run the worker inside the API process (Render single service)
CORS_ORIGINS=               # your Vercel URL if the UI is hosted there, comma-separated
